import pandas as pd
import numpy as np
import joblib

from sklearn.model_selection import StratifiedKFold, cross_val_score
from sklearn.ensemble import HistGradientBoostingClassifier

# 1. تحميل الداتا مباشرة من جيت هب
train_url = "https://raw.githubusercontent.com/Hozaifa-777/smart-irrigation-system/main/data/train_data.csv"
test_url = "https://raw.githubusercontent.com/Hozaifa-777/smart-irrigation-system/main/data/test_features_only.csv"

train_df = pd.read_csv(train_url)
test_df = pd.read_csv(test_url)

# 2. تنظيف أسماء الأعمدة
train_df.columns = train_df.columns.str.strip()
test_df.columns = test_df.columns.str.strip()

# 3. حذف عمود Time لمنع الـ Data Leakage (إجباري حسب التاسك)
if "Time" in train_df.columns:
    train_df = train_df.drop(columns=["Time"])
if "Time" in test_df.columns:
    test_df = test_df.drop(columns=["Time"])

# 4. تجهيز الـ Features والـ Target
FEATURES = [c for c in test_df.columns]
X = train_df[FEATURES]
y = (train_df["Status"].astype(str).str.strip().str.upper() == "ON").astype(int)
X_test = test_df[FEATURES]

print("✅ تم تحميل الداتا وتنظيفها بنجاح من جيت هب!")
print(f"Train shape: {X.shape}, Test shape: {X_test.shape}")
